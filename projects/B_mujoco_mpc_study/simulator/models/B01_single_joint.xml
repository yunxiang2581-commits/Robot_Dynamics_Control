<mujoco model="B01_single_joint">
  <!--
    B01 单关节 MPC 最小 MuJoCo 模型。

    学习目标：
    - 状态 x = [q, dq]，其中 q 来自 hinge joint 角度，dq 来自 hinge joint 角速度。
    - 控制 u = tau，来自 single_joint_motor 的 torque command。
    - 后续 MPC 用该模型做 rollout，预测 x_{k+1} = f(x_k, tau_k)。
  -->

  <compiler angle="radian" coordinate="local"/>

  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="0.05" armature="0.01" limited="true"/>
    <geom density="500" friction="0.8 0.1 0.1"/>
  </default>

  <asset>
    <material name="base_mat" rgba="0.25 0.25 0.25 1"/>
    <material name="link_mat" rgba="0.1 0.45 0.85 1"/>
    <material name="ground_mat" rgba="0.85 0.85 0.85 1"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0 -2 3" dir="0 1 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="fixed" pos="0 -2.2 1.0" xyaxes="1 0 0 0 0.35 1"/>

    <geom name="ground" type="plane" pos="0 0 0" size="2 2 0.02" material="ground_mat"/>

    <body name="base" pos="0 0 0.45">
      <geom name="base_geom" type="box" size="0.07 0.07 0.07" material="base_mat"/>

      <body name="single_link" pos="0 0 0">
        <!--
          hinge 轴沿 y 方向，link 在 x-z 平面内转动。
          range 只用于避免极端姿态；MPC 初期可先在较小角度目标上测试。
        -->
        <joint
          name="single_hinge"
          type="hinge"
          axis="0 1 0"
          range="-3.14159 3.14159"
          damping="0.05"
          armature="0.01"/>

        <geom
          name="single_link_geom"
          type="capsule"
          fromto="0 0 0 0.45 0 0"
          size="0.035"
          material="link_mat"/>

        <site name="tip_site" pos="0.45 0 0" size="0.025" rgba="1 0.2 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!--
      B01 控制输入 tau。
      ctrlrange 与脚本参数 torque_limit 应保持一致或由环境层检查。
    -->
    <motor
      name="single_joint_motor"
      joint="single_hinge"
      gear="1"
      ctrllimited="true"
      ctrlrange="-2 2"/>
  </actuator>

  <sensor>
    <jointpos name="single_hinge_q" joint="single_hinge"/>
    <jointvel name="single_hinge_dq" joint="single_hinge"/>
    <actuatorfrc name="single_joint_tau" actuator="single_joint_motor"/>
  </sensor>
</mujoco>
