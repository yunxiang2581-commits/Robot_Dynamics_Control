<mujoco model="B02_two_link">
  <compiler angle="radian"/>

  <option timestep="0.01" gravity="0 0 -9.81"/>

  <default>
    <joint type="hinge" axis="0 0 1" damping="0.15" armature="0.02"/>
    <geom type="capsule" size="0.035" rgba="0.2 0.45 0.85 1"/>
    <motor ctrllimited="true" ctrlrange="-10 10"/>
  </default>

  <worldbody>
    <light name="key_light" pos="0 0 2.5" dir="0 0 -1"/>
    <geom name="ground" type="plane" pos="0 0 -0.04" size="1.5 1.5 0.02" rgba="0.85 0.85 0.85 1"/>

    <body name="base" pos="0 0 0.05">
      <geom name="base_geom" type="cylinder" size="0.08 0.04" rgba="0.15 0.15 0.15 1"/>

      <body name="link1" pos="0 0 0">
        <joint name="shoulder" range="-3.14 3.14"/>
        <geom name="link1_geom" fromto="0 0 0 0.45 0 0" size="0.035" rgba="0.2 0.45 0.85 1"/>

        <body name="link2" pos="0.45 0 0">
          <joint name="elbow" range="-3.14 3.14"/>
          <geom name="link2_geom" fromto="0 0 0 0.35 0 0" size="0.03" rgba="0.85 0.35 0.2 1"/>
          <site name="ee_site" pos="0.35 0 0" size="0.035" rgba="0.1 0.8 0.25 1"/>
        </body>
      </body>
    </body>

    <camera name="front" pos="0.45 -1.35 0.8" xyaxes="1 0 0 0 0.5 0.866"/>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="1"/>
    <motor name="elbow_motor" joint="elbow" gear="1"/>
  </actuator>
</mujoco>
