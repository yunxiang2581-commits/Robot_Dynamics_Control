<mujoco model="two_link_arm">
    <compiler angle="radian" coordinate="local"/>
     <!-- 设置角度为弧度制 -->
    <option timestep="0.002" gravity="0 0 -9.81"/>
    <!--设置步长、惯性-->
    <visual>
        <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0 0 0"/>
             <!-- 显式效果设置 -->
    </visual>

    <default>
        <joint damping="0.1" armature="0.01"/>
        <geom type="capsule" rgba="0.3 0.6 0.8 1"/>
        <motor ctrllimited="true" ctrlrange="-50 50"/>
    </default>

    <!-- 基座 -->
    <body name="base" pos="0 0 0">
        <gemo type="sphere" size="0.04" rgba="0.2 0.2 0.2 1">

        <!-- 第一连杆 -->
        <body name="link1" pos="0 0 0">
            <joint name="joint1" type="hinge" axis="0 0 1" pos="0 0 0 "/>
            <gemo name="link1_geom" fromto="0 0 0 0.5 0 0" size="0.03"/>

        </body>

    </body>








</mujoco>
