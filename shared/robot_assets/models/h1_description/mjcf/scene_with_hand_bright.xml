      diffuse="1.0 1.0 1.0"
      specular="0.45 0.45 0.45" />

    <light
      name="fill"
      pos="-2.0 1.5 2.2"
      dir="2.0 -1.5 -2.2"
      directional="true"
      diffuse="0.75 0.75 0.80"
      specular="0.20 0.20 0.22" />

    <light
      name="top"
      pos="0.0 0.0 4.2"
      dir="0.0 0.0 -1.0"
      directional="true"
      diffuse="0.85 0.85 0.85"
      specular="0.10 0.10 0.10" />

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
  </worldbody>
</mujoco>
